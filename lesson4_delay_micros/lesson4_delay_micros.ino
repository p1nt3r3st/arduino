// delay(1000); - задержка в милисекундах, максимальное значение 4_294_967_295 мс (почти 50 суток)
// delayMicroseconds(1000); - задержка в микросекундах, максимальное значение 16_383 мкс

// важный момент: delay-функции приостанавливают поток на время n

// millis(); - возвращает кол-во милисекунд, прошедших с момента включения платы, максимальное значение 4_294_967_295 мс, разрешение 1 мс
// micros(); - возвращает кол-во микросекунд, прошедших с момента включения платы, максимальное значение 4_294_967_295 мкс (почти 70 суток),
// разрешение 4 мкс (значение всегда кратно 4)

// при переполнении счётчики сбрасываются в 0


int bodSpeed = 9600;
unsigned long last_time;

void setup() {
  Serial.begin(bodSpeed);
  delay(1000);
}

void loop() {
  if (millis() - last_time > 5000){
    last_time = millis();
    Serial.println("kek");
  }
}
